# Copy to .env and adjust. Every setting is optional in development.

# development | test | production
QL_ENV=development

# SQLite file for development. Production example:
# QL_DATABASE_URL=postgresql+psycopg://quantic:password@db-host:5432/quantic
QL_DATABASE_URL=sqlite:///./quantic.db

# Apply migrations on startup (turn off in production; run `alembic upgrade head` on deploy).
QL_AUTO_MIGRATE=true

# REQUIRED in production: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# QL_JWT_SECRET=

QL_ACCESS_TOKEN_MINUTES=15
QL_REFRESH_TOKEN_DAYS=60

# Browser origins allowed to call the API (JSON list).
QL_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
